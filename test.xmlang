<xmlang version='1.0.0'>
<string to='v'>asdf</string>
<cond to='c1'>
<equiv v1='{var: v}' v2='asdf' />
</cond>
<ifn cond='{var: c1}' block='bl1'>
<print text='TRUE' />
</ifn>
<elseifn cond='{var: c1}' block='bl1'>
<print text='EL' />
</elseifn>
<else block='bl1'>
<print text='AAA' />
</else>
</xmlang>